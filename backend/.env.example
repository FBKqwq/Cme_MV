# PostgreSQL（诊断模块必需）
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=replace_with_database_name

# Web 与知识复验
FRONTEND_ORIGIN=http://localhost:5173
# 留空时默认使用 pro/data/review
# REVIEW_DATA_ROOT=C:/absolute/path/to/review-data

# 自动训练
AUTO_TRAINING_ENABLED=true
AUTO_TRAINING_ANNOTATION_THRESHOLD=1
AUTO_TRAINING_MINIMUM_SAMPLE_COUNT=5
AUTO_TRAINING_MINIMUM_SAMPLES_PER_CLASS=1
AUTO_TRAINING_MACRO_F1_TOLERANCE=0
